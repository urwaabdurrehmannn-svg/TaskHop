# Copy this file to .env and fill in your Supabase project credentials.
# Project Settings -> API in the Supabase dashboard.
# These are safe to expose in the app bundle (EXPO_PUBLIC_ prefix) -- they are
# the public anon key, not a service-role secret. Never put a service-role
# key or other server secret in an EXPO_PUBLIC_ variable.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
